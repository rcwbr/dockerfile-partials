#!/bin/bash
# Starts the webui server if not already running.
# Make Hermes WebUI port publicly accessible on Codespace start.
# Uses gh CLI to change port visibility from private to public.
set -euo pipefail

#shellcheck disable=SC1090
source "${HERMES_WEBUI_ENV_FILE}"
/opt/devcontainers/hermes-webui/ctl.sh start

# Wait for the webui server to become fully ready before making the port public.
# Polls /api/system/health (with auth) for status: ok AND available: true.
# This is more thorough than /health — it confirms system resources (CPU/memory/disk)
# are available, not just that the accept loop is running.
echo "Waiting for Hermes WebUI to become ready..."
HWEBUI_HOST="${HERMES_WEBUI_HOST:-127.0.0.1}"
HWEBUI_PORT="${HERMES_WEBUI_PORT:-8787}"
_health_url="http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/system/health"

# Obtain a session cookie by logging in with the configured password.
# /api/system/health requires authentication.
_auth_cookie=""
if [ -n "${HERMES_WEBUI_PASSWORD:-}" ] && [ "${HERMES_WEBUI_PASSWORD:-}" != "None" ] && [ "${HERMES_WEBUI_PASSWORD:-}" != "" ]; then
  _login_resp="$(curl -s --max-time 5 -X POST "http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"password\": \"${HERMES_WEBUI_PASSWORD}\"}" \
    -c - 2>/dev/null)" || true
  _auth_cookie="$(printf '%s\n' "${_login_resp}" | grep -oP 'session_id\s+\S+' | awk '{print $1"="$NF}')"
fi

# Poll /api/system/health until status == "ok" AND available == true
_ready=0
_wait=0
while [ "${_wait}" -lt 120 ]; do
  _resp="$(curl -s --max-time 5 "${_health_url}" \
    ${ _auth_cookie:+-H "Cookie: ${_auth_cookie}" } 2>/dev/null)" || true
  if printf '%s' "${_resp}" | grep -q '"status".*"ok"' && printf '%s' "${_resp}" | grep -q '"available".*true'; then
    _ready=1
    break
  fi
  sleep 5
  _wait=$((_wait + 5))
done

if [ "${_ready}" -ne 1 ]; then
  echo "[error] Hermes WebUI did not become ready (status:ok + available:true) within 120 seconds" >&2
  echo "[error] Last response: ${_resp}" >&2
  exit 1
fi

echo "Hermes WebUI is ready (status: ok, available: true)"

# Only make the port public inside a Codespace.
# CODESPACE_NAME may not be set as a container env var on all Codespace
# configurations (e.g. when using "image" mode without the devcontainer
# remoteEnv propagation). Fall back to reading it from the shared env file.
if [ -z "${CODESPACE_NAME:-}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    CODESPACE_NAME="$(grep '^CODESPACE_NAME=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -z "${CODESPACE_NAME:-}" ]; then
  echo "Not running in a Codespace — skipping public port setup"
  exit 0
fi

# Ensure gh is authenticated for codespace port management.
# GITHUB_TOKEN is NOT set in the container's shell environment by default;
# it lives in /workspaces/.codespaces/shared/.env. Read it from there as fallback.
_gh_token="${GITHUB_TOKEN:-}"
if [ -z "${_gh_token}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    _gh_token="$(grep '^GITHUB_TOKEN=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -n "${_gh_token}" ]; then
  echo "Configuring gh CLI authentication..."
  # Set GH_TOKEN environment variable for gh CLI authentication.
  # We avoid `gh auth login --with-token` because piping to it in a postStartCommand
  # context can cause stdin issues that prematurely terminate the script.
  export GH_TOKEN="${_gh_token}"
fi

# Verify gh authentication before attempting port visibility change
if ! gh auth status >/dev/null 2>&1; then
  echo "[error] gh CLI is not authenticated — cannot set port visibility" >&2
  echo "[error] GITHUB_TOKEN was not found in env or /workspaces/.codespaces/shared/.env" >&2
  exit 1
fi

# Make port 8787 publicly accessible.
# See: https://docs.github.com/en/codespaces/setting-up-your-project-for-codespaces/forwarding-ports-in-your-codespace
echo "Making port 8787 public on Codespace: $CODESPACE_NAME"
if gh codespace ports visibility 8787:public --codespace "$CODESPACE_NAME" 2>/dev/null; then
  # Verify the port is actually public now
  _visibility="$(gh codespace ports --codespace "$CODESPACE_NAME" 2>/dev/null | awk '/8787/ {print $4}')"
  if [ "${_visibility}" = "public" ]; then
    echo "Port 8787 is now publicly accessible"
    echo "URL: https://${CODESPACE_NAME}-8787.app.github.dev"
  else
    echo "[error] Port visibility command succeeded but port 8787 is '${_visibility}' (expected 'public')" >&2
    echo "[error] Try running manually: gh codespace ports visibility 8787:public --codespace \"${CODESPACE_NAME}\"" >&2
    exit 1
  fi
else
  echo "[error] Failed to set port 8787 visibility to public on Codespace: ${CODESPACE_NAME}" >&2
  echo "[error] gh codespace ports visibility command returned non-zero exit code" >&2
  echo "[error] Current port state:" >&2
  gh codespace ports --codespace "$CODESPACE_NAME" 2>&1 | head -20 >&2 || true
  exit 1
fi
