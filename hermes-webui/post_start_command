#!/bin/bash
# Starts the webui server, Traefik reverse proxy, landing page server,
# then makes port 8780 publicly accessible on Codespace start.
# Port 8787 is the main WebUI port. Port 8780 runs Traefik which proxies
# to 8787 and serves a landing page while the WebUI is still starting up.
set -euo pipefail

# Source the Hermes Web UI env file.
# This file sources the shared Codespaces .env file and exports the needed vars.
if [ -n "${HERMES_WEBUI_ENV_FILE:-}" ] && [ -f "${HERMES_WEBUI_ENV_FILE}" ]; then
  # shellcheck disable=SC1090
  source "${HERMES_WEBUI_ENV_FILE}"
fi

# --- Start Hermes Web UI ---
/opt/devcontainers/hermes-webui/ctl.sh start

# --- Start landing page server (Python http.server on port 8081) ---
# Traefik proxies to this when the WebUI is not yet ready (502/503/504).
echo "Starting landing page server on port 8081..."
_landing_dir="/opt/devcontainers/hermes-webui/traefik/static"
nohup python3 -m http.server 8081 --directory "${_landing_dir}" --bind 0.0.0.0 >/dev/null 2>&1 &
disown

# --- Start Traefik reverse proxy (port 8780 -> 8787) ---
# The Docker daemon runs on the Codespace host VM and cannot see files in the
# devcontainer container's overlay filesystem at /opt/devcontainers/. However,
# Docker named volumes are managed by the host VM's Docker daemon and are
# accessible to containers. We write config files into a named volume using
# base64 echo (via a temporary container), then mount that volume into Traefik.
# Named volumes persist across container restarts and survive Codespace re-starts.
echo "Starting Traefik reverse proxy on port 8780..."

_traefik_vol="traefik-config-data"
_traefik_src="/opt/devcontainers/hermes-webui/traefik"

# Create named volume (idempotent — docker volume create is safe to repeat)
docker volume create "${_traefik_vol}" >/dev/null 2>&1

# Check if config is already in the volume (skip re-population on restarts)
if ! docker run --rm -v "${_traefik_vol}:/config" alpine:3.20 test -f /config/traefik.yml 2>/dev/null; then
  echo "Populating Traefik config volume..."

  # Start temp container to write config files into the named volume
  docker rm -f traefik-vol-builder 2>/dev/null || true
  docker run -d --name traefik-vol-builder \
    -v "${_traefik_vol}:/etc/traefik" \
    --entrypoint sleep alpine:3.20 999 2>/dev/null
  sleep 1

  # Write config files using base64 encoding (avoids shell escaping issues)
  docker exec traefik-vol-builder mkdir -p /etc/traefik/dynamic

  _traefik_yml_b64="$(base64 -w0 "${_traefik_src}/traefik.yml")"
  _webui_yml_b64="$(base64 -w0 "${_traefik_src}/dynamic/webui.yml")"

  docker exec traefik-vol-builder sh -c "echo '${_traefik_yml_b64}' | base64 -d > /etc/traefik/traefik.yml"
  docker exec traefik-vol-builder sh -c "echo '${_webui_yml_b64}' | base64 -d > /etc/traefik/dynamic/webui.yml"

  # Clean up temp container (volume persists)
  docker rm -f traefik-vol-builder >/dev/null 2>&1
  echo "Config volume populated"
fi

# Remove stale Traefik container if present
docker rm -f traefik-proxy 2>/dev/null || true

# Start Traefik from named volume (default entrypoint, no override needed)
docker run -d --name traefik-proxy \
  -p 8780:8780 \
  -v "${_traefik_vol}:/etc/traefik:ro" \
  --add-host=host.docker.internal:host-gateway \
  traefik:v3.7.13 \
  --configFile=/etc/traefik/traefik.yml 2>/dev/null

# --- Wait for readiness and make port public ---
# Uses finalize_port_public.py which:
# 1. Polls /health until the WebUI returns status == "ok" (max 120 seconds)
# 2. Makes port 8780 publicly accessible via the Tunnels Management API
echo "Waiting for readiness and making port 8780 public..."
python3 /opt/devcontainers/hermes-webui/scripts/finalize_port_public.py 8780
