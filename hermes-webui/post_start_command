#!/bin/bash
# Starts the webui server and Traefik reverse proxy, then makes port 8787
# publicly accessible on Codespace start.
# Port 8787 is the main WebUI port. Port 8780 runs Traefik which proxies
# to 8787 and serves a landing page while the WebUI is still starting up.
set -euo pipefail

# Source the Hermes WebUI env file
#shellcheck disable=SC1090
source "${HERMES_WEBUI_ENV_FILE}"

# --- Start Hermes WebUI ---
/opt/devcontainers/hermes-webui/ctl.sh start

# --- Start Traefik proxy (port 8780 -> 8787) ---
# The proxy provides a landing page while the WebUI boots. Port 8780 is
# auto-detected by the Codespace port forwarding service when Traefik
# starts listening (no need for forwardPorts on 8780).
echo "Starting Traefik reverse proxy on port 8780..."
docker compose -f /opt/devcontainers/hermes-webui/traefik/docker-compose.yml up -d --build 2>/dev/null

# --- Wait for the WebUI server to become fully ready ---
# Polls /api/system/health for status: ok AND available: true.
# This is more thorough than /health — it confirms system resources
# (CPU/memory/disk) are available, not just that the accept loop is running.
echo "Waiting for Hermes Web UI to become ready..."
HWEBUI_HOST="${HERMES_WEBUI_HOST:-127.0.0.1}"
HWEBUI_PORT="${HERMES_WEBUI_PORT:-8787}"
_health_url="http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/system/health"
_cookie_jar="/tmp/hermes_webui_cookiejar"
rm -f "${_cookie_jar}"

# If a password is configured, authenticate first to get a session cookie.
# /api/system/health requires authentication when HERMES_WEBUI_PASSWORD is set.
if [ -n "${HERMES_WEBUI_PASSWORD:-}" ] && [ "${HERMES_WEBUI_PASSWORD:-}" != "None" ]; then
  curl -s --max-time 5 -X POST "http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"password\": \"${HERMES_WEBUI_PASSWORD}\"}" \
    -c "${_cookie_jar}" >/dev/null 2>/dev/null || true
fi

# Poll /api/system/health until status == "ok" AND available == true
_ready=0
_wait=0
while [ "${_wait}" -lt 120 ]; do
  _resp="$(curl -s --max-time 5 "${_health_url}" -b "${_cookie_jar}" 2>/dev/null)" || true
  if printf '%s' "${_resp}" | grep -q '"status".*"ok"' && printf '%s' "${_resp}" | grep -q '"available".*true'; then
    _ready=1
    break
  fi
  sleep 5
  _wait=$((_wait + 5))
done

if [ "${_ready}" -ne 1 ]; then
  echo "[error] Hermes Web UI did not become ready (status:ok + available:true) within 120 seconds" >&2
  echo "[error] Last response: ${_resp}" >&2
  exit 1
fi

echo "Hermes Web UI is ready (status: ok, available: true)"

# --- Make port 8787 publicly accessible ---
# Only do this inside a Codespace.
# CODESPACE_NAME may not be set as a container env var on all Codespace
# configurations. Fall back to reading it from the shared env file.
if [ -z "${CODESPACE_NAME:-}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    CODESPACE_NAME="$(grep '^CODESPACE_NAME=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -z "${CODESPACE_NAME:-}" ]; then
  echo "Not running in a Codespace — skipping public port setup"
  exit 0
fi

# Ensure gh is authenticated for codespace port management.
# GITHUB_TOKEN may not be set in the container's shell environment directly;
# it lives in /workspaces/.codespaces/shared/.env. Read it from there as fallback.
_gh_token="${GITHUB_TOKEN:-}"
if [ -z "${_gh_token}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    _gh_token="$(grep '^GITHUB_TOKEN=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -n "${_gh_token}" ]; then
  echo "Configuring gh CLI authentication..."
  export GH_TOKEN="${_gh_token}"
fi

# Verify gh authentication before attempting port visibility change
if ! gh auth status >/dev/null 2>&1; then
  echo "[error] gh CLI is not authenticated — cannot set port visibility" >&2
  echo "[error] GITHUB_TOKEN was not found in env or /workspaces/.codespaces/shared/.env" >&2
  exit 1
fi

# Make port 8787 publicly accessible.
# Port 8787 is pre-registered via forwardPorts in devcontainer.json.
# The Traefik proxy on port 8780 is auto-detected by the Codespace port forwarder.
echo "Making port 8787 public on Codespace: ${CODESPACE_NAME}"
if gh codespace ports visibility 8787:public --codespace "${CODESPACE_NAME}" 2>/dev/null; then
  # Verify the port is actually public now
  _visibility="$(gh codespace ports --codespace "${CODESPACE_NAME}" 2>/dev/null | awk '/8787/ {print $4}')"
  if [ "${_visibility}" = "public" ]; then
    echo "Port 8787 is now publicly accessible"
    echo "URL: https://${CODESPACE_NAME}-8787.app.github.dev"
  else
    echo "[error] Port visibility command succeeded but port 8787 is '${_visibility}' (expected 'public')" >&2
    echo "[error] gh codespace ports shows:" >&2
    gh codespace ports --codespace "${CODESPACE_NAME}" 2>&1 | head -20 >&2 || true
    exit 1
  fi
else
  echo "[error] Failed to set port 8787 visibility to public on Codespace: ${CODESPACE_NAME}" >&2
  echo "[error] gh codespace ports visibility command returned non-zero exit code" >&2
  echo "[error] Current port state:" >&2
  gh codespace ports --codespace "${CODESPACE_NAME}" 2>&1 | head -20 >&2 || true
  exit 1
fi
