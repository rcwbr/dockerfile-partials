#!/bin/bash
# Starts the webui server and Traefik reverse proxy, then makes port 8787
# publicly accessible on Codespace start.
# Port 8787 is the main WebUI port. Port 8780 runs Traefik which proxies
# to 8787 and serves a landing page while the WebUI is still starting up.
set -euo pipefail

# Source the Hermes WebUI env file.
# This file is a bash script (not just KEY=VALUE pairs) — it handles
# extracting env vars from /workspaces/.codespaces/shared/.env while
# skipping readonly vars like UID.
if [ -n "${HERMES_WEBUI_ENV_FILE:-}" ] && [ -f "${HERMES_WEBUI_ENV_FILE}" ]; then
  # shellcheck disable=SC1090
  source "${HERMES_WEBUI_ENV_FILE}"
fi

# --- Start Hermes WebUI ---
/opt/devcontainers/hermes-webui/ctl.sh start

# --- Start Traefik proxy (port 8780 -> 8787) ---
# The proxy provides a landing page while the WebUI boots. Port 8780 is
# auto-detected by the Codespace port forwarding service when Traefik
# starts listening (no need for forwardPorts on 8780).
echo "Starting Traefik reverse proxy on port 8780..."
docker compose -f /opt/devcontainers/hermes-webui/traefik/docker-compose.yml up -d --build 2>/dev/null || true

# --- Wait for the WebUI server to become fully ready ---
# Polls /api/system/health for status: ok AND available: true.
# This is more thorough than /health — it confirms system resources
# (CPU/memory/disk) are available, not just that the accept loop is running.
echo "Waiting for Hermes Web UI to become ready..."
HWEBUI_HOST="${HERMES_WEBUI_HOST:-127.0.0.1}"
HWEBUI_PORT="${HERMES_WEBUI_PORT:-8787}"
_health_url="http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/system/health"
_cookie_jar="/tmp/hermes_webui_cookiejar"
rm -f "${_cookie_jar}"

# If a password is configured, authenticate first to get a session cookie.
# /api/system/health requires authentication when HERMES_WEBUI_PASSWORD is set.
if [ -n "${HERMES_WEBUI_PASSWORD:-}" ] && [ "${HERMES_WEBUI_PASSWORD:-}" != "None" ]; then
  curl -s --max-time 5 -X POST "http://${HWEBUI_HOST}:${HWEBUI_PORT}/api/auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"password\": \"${HERMES_WEBUI_PASSWORD}\"}" \
    -c "${_cookie_jar}" >/dev/null 2>/dev/null || true
fi

# Poll /api/system/health until status == "ok" AND available == true
_ready=0
_wait=0
while [ "${_wait}" -lt 120 ]; do
  if curl -s --max-time 5 -o /dev/null -w '%{http_code}' "${_health_url}" -b "${_cookie_jar}" 2>/dev/null | grep -q '^200'; then
    _resp="$(curl -s --max-time 5 "${_health_url}" -b "${_cookie_jar}" 2>/dev/null)" || true
    if printf '%s' "${_resp}" | grep -q '"status".*"ok"' && printf '%s' "${_resp}" | grep -q '"available".*true'; then
      _ready=1
      break
    fi
  fi
  sleep 5
  _wait=$((_wait + 5))
done

if [ "${_ready}" -ne 1 ]; then
  echo "[error] Hermes Web UI did not become ready (status:ok + available:true) within 120 seconds" >&2
  echo "[error] Last response: ${_resp:-<empty>}" >&2
  exit 1
fi

echo "Hermes Web UI is ready (status: ok, available: true)"

# --- Make port 8787 publicly accessible ---
# Only do this inside a Codespace.
# CODESPACE_NAME may not be set as a container env var on all Codespace
# configurations. Fall back to reading it from the shared env file.
if [ -z "${CODESPACE_NAME:-}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    CODESPACE_NAME="$(grep '^CODESPACE_NAME=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -z "${CODESPACE_NAME:-}" ]; then
  echo "Not running in a Codespace — skipping public port setup"
  exit 0
fi

# Ensure gh is authenticated for codespace port management.
# GITHUB_TOKEN may not be set in the container's shell environment directly;
# it lives in /workspaces/.codespaces/shared/.env. Read it from there as fallback.
_gh_token="${GITHUB_TOKEN:-}"
if [ -z "${_gh_token}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    _gh_token="$(grep '^GITHUB_TOKEN=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -n "${_gh_token}" ]; then
  export GH_TOKEN="${_gh_token}"
fi

# Verify gh authentication before attempting port visibility change
if ! gh auth status >/dev/null 2>&1; then
  echo "[error] gh CLI is not authenticated — cannot set port visibility" >&2
  echo "[error] GITHUB_TOKEN was not found in env or /workspaces/.codespaces/shared/.env" >&2
  exit 1
fi

# Ensure port 8787 is registered. The forwardPorts directive in
# devcontainer.json should pre-register the port, but on pre-built Docker
# images the Codespace port-forwarding proxy sometimes fails to detect it.
# If the port is not visible via `gh codespace ports`, create it directly
# on the Codespace's VS Code Tunnel using the Tunnels Management API.
echo "Making port 8787 public on Codespace: ${CODESPACE_NAME}"

# Try setting visibility directly first (works if port is pre-registered)
if gh codespace ports visibility 8787:public --codespace "${CODESPACE_NAME}" 2>/dev/null; then
  _visibility="$(gh codespace ports --codespace "${CODESPACE_NAME}" --json sourcePort,visibility --jq '.[] | select(.sourcePort == 8787) | .visibility' 2>/dev/null)"
  if [ "${_visibility}" = "public" ]; then
    echo "Port 8787 is now publicly accessible"
    echo "URL: https://${CODESPACE_NAME}-8787.app.github.dev"
    exit 0
  fi
  echo "[error] Port visibility command succeeded but port 8787 is '${_visibility:-<unknown>}' (expected 'public')" >&2
  gh codespace ports --codespace "${CODESPACE_NAME}" 2>&1 | head -20 >&2 || true
  exit 1
fi

# --- Fallback: register port 8787 via the Tunnels Management API ---
# The Codespace's port-forwarding tunnel uses the VS Code Tunnels protocol.
# When forwardPorts doesn't register the port, we create it ourselves.
echo "Port 8787 not registered via forwardPorts — creating via Tunnels API..."

# Get the Codespace details (includes tunnelProperties with auth tokens)
_cs_info="$(gh api "/user/codespaces/${CODESPACE_NAME}?internal=true&refresh=true" \
  -H "Accept: application/vnd.github+json" 2>/dev/null)"

if [ -z "${_cs_info}" ]; then
  echo "[error] Failed to retrieve Codespace details for ${CODESPACE_NAME}" >&2
  exit 1
fi

# Extract tunnel properties using python3 (more reliable than grep/jq)
_tunnel_info="$(printf '%s' "${_cs_info}" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    tp = d.get('connection', {}).get('tunnelProperties', {})
    print(json.dumps(tp))
except Exception as e:
    print(json.dumps({'error': str(e)}))
" 2>/dev/null)"

if [ -z "${_tunnel_info}" ] || printf '%s' "${_tunnel_info}" | grep -q '"error"'; then
  echo "[error] Failed to extract tunnel properties from Codespace details" >&2
  exit 1
fi

_tunnel_id="$(printf '%s' "${_tunnel_info}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tunnelId',''))")"
_tunnel_token="$(printf '%s' "${_tunnel_info}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('managePortsAccessToken',''))")"
_tunnel_service_uri="$(printf '%s' "${_tunnel_info}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('serviceUri',''))")"

if [ -z "${_tunnel_id}" ] || [ -z "${_tunnel_token}" ] || [ -z "${_tunnel_service_uri}" ]; then
  echo "[error] Missing tunnel connection properties (tunnelId/token/serviceUri)" >&2
  exit 1
fi

# Create port 8787 on the tunnel, with public (anonymous) access.
# The Tunnels Management API accepts PUT to create/replace a port.
# accessControl with Anonymous + connect scope makes the port publicly accessible.
_create_resp="$(curl -s -X PUT \
  "${_tunnel_service_uri}tunnels/${_tunnel_id}/ports/8787?api-version=2023-09-27-preview" \
  -H "Authorization: Tunnel ${_tunnel_token}" \
  -H "Content-Type: application/json" \
  -d '{
    "portNumber": 8787,
    "labels": ["UserForwardedPort"],
    "protocol": "http",
    "accessControl": {
      "entries": [
        {
          "type": "Anonymous",
          "subjects": [],
          "scopes": ["connect"]
        }
      ]
    },
    "options": {
      "isGloballyAvailable": true
    }
  }' 2>/dev/null)"

# Verify the port was created and is publicly accessible
if printf '%s' "${_create_resp}" | grep -q '"portForwardingUris"'; then
  _url="$(printf '%s' "${_create_resp}" | python3 -c "import sys,json; print(json.load(sys.stdin)['portForwardingUris'][0])" 2>/dev/null)"
  if [ -n "${_url}" ]; then
    echo "Port 8787 is now publicly accessible"
    echo "URL: ${_url}"
    exit 0
  fi
fi

echo "[error] Failed to create port 8787 on the Codespace tunnel" >&2
echo "[error] Tunnels API response: ${_create_resp}" >&2
exit 1
