#!/bin/bash
# Starts the webui server if not already running.
# Make Hermes WebUI port publicly accessible on Codespace start.
# Uses gh CLI to change port visibility from private to public.
set -euo pipefail

#shellcheck disable=SC1090
source "${HERMES_WEBUI_ENV_FILE}"
/opt/devcontainers/hermes-webui/ctl.sh start

# Wait for the webui server to become healthy before making the port public.
# Polls ctl.sh status instead of a fixed sleep so we block only as long as needed.
echo "Waiting for Hermes WebUI to become healthy..."
_wait=0
while [ "${_wait}" -lt 300 ]; do
  if /opt/devcontainers/hermes-webui/ctl.sh status 2>/dev/null | grep -q 'Health:.*ok'; then
    echo "Hermes WebUI is healthy"
    break
  fi
  sleep 5
  _wait=$((_wait + 5))
done

if [ "${_wait}" -ge 300 ]; then
  echo "[error] Hermes WebUI did not become healthy within 300 seconds — skipping public port setup" >&2
  exit 1
fi

# Only make the port public inside a Codespace
if [ -z "${CODESPACE_NAME:-}" ]; then
  echo "Not running in a Codespace — skipping public port setup"
  exit 0
fi

# Ensure gh is authenticated for codespace port management.
# GITHUB_TOKEN is NOT set in the container's shell environment by default;
# it lives in /workspaces/.codespaces/shared/.env. Read it from there as fallback.
_gh_token="${GITHUB_TOKEN:-}"
if [ -z "${_gh_token}" ]; then
  _env_file="/workspaces/.codespaces/shared/.env"
  if [ -f "${_env_file}" ]; then
    _gh_token="$(grep '^GITHUB_TOKEN=' "${_env_file}" | cut -d= -f2-)"
  fi
fi

if [ -n "${_gh_token}" ]; then
  echo "Authenticating gh CLI..."
  printf '%s\n' "${_gh_token}" | gh auth login --with-token
fi

# Verify gh authentication before attempting port visibility change
if ! gh auth status >/dev/null 2>&1; then
  echo "[error] gh CLI is not authenticated — cannot set port visibility" >&2
  echo "[error] GITHUB_TOKEN was not found in env or /workspaces/.codespaces/shared/.env" >&2
  exit 1
fi

# Make port 8787 publicly accessible.
# See: https://docs.github.com/en/codespaces/setting-up-your-project-for-codespaces/forwarding-ports-in-your-codespace
echo "Making port 8787 public on Codespace: $CODESPACE_NAME"
if gh codespace ports visibility 8787:public --codespace "$CODESPACE_NAME" 2>/dev/null; then
  # Verify the port is actually public now
  _visibility="$(gh codespace ports --codespace "$CODESPACE_NAME" 2>/dev/null | awk '/8787/ {print $4}')"
  if [ "${_visibility}" = "public" ]; then
    echo "Port 8787 is now publicly accessible"
    echo "URL: https://${CODESPACE_NAME}-8787.app.github.dev"
  else
    echo "[error] Port visibility command succeeded but port 8787 is '${_visibility}' (expected 'public')" >&2
    echo "[error] Try running manually: gh codespace ports visibility 8787:public --codespace \"${CODESPACE_NAME}\"" >&2
    exit 1
  fi
else
  echo "[error] Failed to set port 8787 visibility to public on Codespace: ${CODESPACE_NAME}" >&2
  echo "[error] gh codespace ports visibility command returned non-zero exit code" >&2
  echo "[error] Current port state:" >&2
  gh codespace ports --codespace "$CODESPACE_NAME" 2>&1 | head -20 >&2 || true
  exit 1
fi
