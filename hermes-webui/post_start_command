#!/bin/bash
# Starts the Hermes WebUI server, then makes port 8787 publicly accessible
# on Codespace start.
#
# Port 8787 is the main WebUI port. The WebUI runs directly in the
# devcontainer.
# finalize_port_public.py waits for the WebUI /health endpoint, then
# registers port 8787 as public via the Codespaces Tunnels API + gh CLI.
set -euo pipefail

# Source the Hermes Web UI env file.
# This file sources the shared Codespaces .env file and exports the needed vars.
if [ -n "${HERMES_WEBUI_ENV_FILE:-}" ] && [ -f "${HERMES_WEBUI_ENV_FILE}" ]; then
  # shellcheck disable=SC1090
  source "${HERMES_WEBUI_ENV_FILE}"
fi

# Explicitly ensure the WebUI port is 8787 (Traefik was removed; the WebUI
# listens directly on this port).  Setting this after sourcing .hermes-webui.env
# guarantees it isn't clobbered by any stale .env in the hermes_webui image.
export HERMES_WEBUI_PORT=8787
export HERMES_WEBUI_HOST="${HERMES_WEBUI_HOST:-0.0.0.0}"

# --- Start Hermes Web UI ---
echo "[postStart] Starting Hermes Web UI on ${HERMES_WEBUI_HOST}:${HERMES_WEBUI_PORT}..."
set +e
/opt/devcontainers/hermes-webui/ctl.sh start
_ctl_exit=$?
set -e
echo "[postStart] ctl.sh start exit code: ${_ctl_exit}"

# --- Wait for WebUI health and make port 8787 public ---
# finalize_port_public.py:
# 1. Polls /health on port 8787 until the WebUI returns status == "ok" (max 120s)
# 2. If in a Codespace: registers port 8787 as public via the Tunnels Management API,
#    toggles visibility (private->public) via gh CLI + Tunnels API to fix stale
#    Codespace tunnel entries, and verifies the public endpoint returns HTTP 200.
# 3. Retries the register+toggle+verify cycle for up to 5 minutes.
#
# On Codespace stop/start, the tunnel proxy's forwarding path can become stale.
# The gh CLI visibility toggle re-establishes the relay host connection.
# gh CLI needs GH_TOKEN set.
if [ -z "${GH_TOKEN:-}" ] && [ -n "${HERMES_GITHUB_TOKEN:-}" ]; then
  export GH_TOKEN="${HERMES_GITHUB_TOKEN}"
fi
if [ -z "${GITHUB_TOKEN:-}" ] && [ -n "${HERMES_GITHUB_TOKEN:-}" ]; then
  export GITHUB_TOKEN="${HERMES_GITHUB_TOKEN}"
fi
echo "Waiting for WebUI health and making port 8787 public..."
set +e
python3 /opt/devcontainers/hermes-webui/scripts/finalize_port_public.py 8787 > /tmp/finalize_port_public.log 2>&1
_finalize_exit=$?
set -e
echo "finalize_port_public.py exit code: ${_finalize_exit}"
echo "${_finalize_exit}" > /tmp/finalize_port_public.exit_code
if [ "${_finalize_exit}" -ne 0 ]; then
  echo "[postStart] WARNING: finalize_port_public.py exited with code ${_finalize_exit}" >&2
  echo "[postStart] ctl.sh start exit code was: ${_ctl_exit}" >&2
fi
echo "Done"
