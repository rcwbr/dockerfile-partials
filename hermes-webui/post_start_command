#!/bin/bash
# Starts the Hermes WebUI server, then makes port 8787 publicly accessible
# on Codespace start.
#
# Port 8787 is the main WebUI port. The WebUI runs directly in the
# devcontainer (no Traefik reverse proxy, no landing-page server).
# finalize_port_public.py waits for the WebUI /health endpoint, then
# registers port 8787 as public via the Codespaces Tunnels API + gh CLI.
set -euo pipefail

# Source the shared Codespaces env file FIRST, before .hermes-webui.env,
# so that GITHUB_TOKEN (codespace runtime token) is available.
# Use ". " (dot) instead of "source" for POSIX sh compatibility.
if [ -f /workspaces/.codespaces/shared/.env ]; then
  set +e
  . /workspaces/.codespaces/shared/.env
  set -e
fi

# Source the Hermes Web UI env file.
# This file may also source the shared Codespaces .env file and set additional vars.
if [ -n "${HERMES_WEBUI_ENV_FILE:-}" ] && [ -f "${HERMES_WEBUI_ENV_FILE}" ]; then
  # shellcheck disable=SC1090
  set +e
  . "${HERMES_WEBUI_ENV_FILE}"
  set -e
fi

# Explicitly ensure the WebUI port is 8787 (Traefik was removed; the WebUI
# listens directly on this port).  Setting this after sourcing env files
# guarantees it isn't clobbered by any stale .env in the hermes_webui image.
export HERMES_WEBUI_PORT=8787
export HERMES_WEBUI_HOST="${HERMES_WEBUI_HOST:-0.0.0.0}"

# Authenticate gh CLI for codespace API access (gh codespace ports visibility).
# Prefer GITHUB_TOKEN (codespace runtime token) over HERMES_GITHUB_TOKEN (PAT).
if ! gh auth status 2>/dev/null; then
  _token="${GITHUB_TOKEN:-${HERMES_GITHUB_TOKEN:-}}"
  if [ -n "$_token" ]; then
    set +e
    echo "$_token" | gh auth login --with-token 2>/dev/null || true
    set -e
  fi
fi

# Set GH_TOKEN for finalize_port_public.py's gh CLI calls.
# Prefer GITHUB_TOKEN (codespace token) over HERMES_GITHUB_TOKEN (PAT).
# Do NOT overwrite GITHUB_TOKEN if it's already set — the codespace runtime
# token may have broader scopes than the PAT.
if [ -z "${GH_TOKEN:-}" ]; then
  export GH_TOKEN="${GITHUB_TOKEN:-${HERMES_GITHUB_TOKEN:-}}"
fi

# --- Start Hermes Web UI ---
echo "[postStart] Starting Hermes Web UI on ${HERMES_WEBUI_HOST}:${HERMES_WEBUI_PORT}..."
set +e
/opt/devcontainers/hermes-webui/ctl.sh start
_ctl_exit=$?
set -e
echo "[postStart] ctl.sh start exit code: ${_ctl_exit}"

# --- Wait for WebUI health and make port 8787 public ---
# finalize_port_public.py:
# 1. Polls /health on port 8787 until the WebUI returns status == "ok" (max 600s)
#    — the extended timeout accommodates slow first-time Python imports on
#      fresh codespaces (the run_agent module compiles .pyc files on first import,
#      which can take 5+ minutes).
# 2. If in a Codespace: registers port 8787 as public via the Tunnels API + gh CLI
#    visibility toggle (private->public).
# 3. If the Tunnels API/CLI approach fails (e.g., token scope issues), the port
#    is still forwarded as PUBLIC via devcontainer.json's forwardPorts +
#    portsAttributes (Codespaces handles this natively, without API tokens).
# 4. Retries the register+toggle+verify cycle for up to 5 minutes.
#
# On Codespace stop/start, the tunnel proxy's forwarding path can become stale.
# The gh CLI visibility toggle re-establishes the relay host connection.
echo "Waiting for WebUI health and making port 8787 public..."
echo "GH_TOKEN: ${GH_TOKEN:+set}" >&2
echo "GITHUB_TOKEN: ${GITHUB_TOKEN:+set}" >&2
echo "CODESPACE_NAME: ${CODESPACE_NAME:-unset}" >&2
echo "Running finalize_port_public.py..."
set +e
python3 /opt/devcontainers/hermes-webui/scripts/finalize_port_public.py 8787 > /tmp/finalize_port_public.log 2>&1
_finalize_exit=$?
set -e
echo "finalize_port_public.py exit code: ${_finalize_exit}"
echo "${_finalize_exit}" > /tmp/finalize_port_public.exit_code
if [ "${_finalize_exit}" -ne 0 ]; then
  echo "[postStart] WARNING: finalize_port_public.py exited with code ${_finalize_exit}" >&2
  echo "[postStart] Port 8787 should still be forwarded as PUBLIC via devcontainer.json portsAttributes" >&2
  echo "[postStart] ctl.sh start exit code was: ${_ctl_exit}" >&2
fi
echo "Done"
