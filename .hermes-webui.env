#!/bin/bash

# In Codespaces, some env vars (like OPENROUTER_API_KEY) are not exported
# into the container environment directly. They are available in the
# shared env file at /workspaces/.codespaces/shared/.env, which Codespaces
# injects as user secrets.
# Source it so all secrets are available for the .env file written below.
if [ -f /workspaces/.codespaces/shared/.env ]; then
  # Source env vars from the shared env file.
  # NOTE: We must NOT use `set -a` + `. file` under `set -e` because the .env
  # file contains UID=1000 (and possibly USER=...) which are readonly/read-only
  # in bash and sourcing them triggers "readonly variable" errors that abort
  # the script under `set -e`. Instead, we extract only the variables we need:
  # GITHUB_TOKEN (for gh auth in post_start_command), HERMES_GITHUB_TOKEN,
  # OPENROUTER_API_KEY, HERMES_WEBUI_PASSWORD, and CODESPACE_NAME.
  while IFS='=' read -r _key _val; do
    case "$_key" in
      UID|USER|CODESPACES|LOGNAME|PWD|HOME|SHELL)
        # Skip vars that conflict with bash builtins / readonly vars
        continue
        ;;
      GITHUB_TOKEN|HERMES_GITHUB_TOKEN|OPENROUTER_API_KEY|HERMES_WEBUI_PASSWORD|HERMES_WEBUI_DEFAULT_MODEL|HERMES_CUSTOM_INFERENCE_POOLSIDE_AI_API_KEY|CODESPACE_NAME)
        export "$_key=$_val"
        ;;
    esac
  done < /workspaces/.codespaces/shared/.env
fi

HERMES_HOME="${HERMES_HOME:-${HOME}/.hermes}"

mkdir -p "${CONTAINER_WORKSPACE_FOLDER}/.hermes"
sudo ln -sfn "${CONTAINER_WORKSPACE_FOLDER}/.hermes" "${HERMES_HOME}"
sudo chown -R "${USER}:${USER}" "${HERMES_HOME}"
cat <<EOF > "${HERMES_HOME}/.env"
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"
# Fallback: defaults to the OpenRouter key as a safety net
export HERMES_CUSTOM_INFERENCE_POOLSIDE_AI_API_KEY="${HERMES_CUSTOM_INFERENCE_POOLSIDE_AI_API_KEY:-${OPENROUTER_API_KEY:-}}"
export HERMES_WEBUI_PASSWORD="${HERMES_WEBUI_PASSWORD:-}"
export HERMES_WEBUI_DEFAULT_MODEL="${HERMES_WEBUI_DEFAULT_MODEL:-poolside/laguna-s-2.1:free}"
export HERMES_WEBUI_SKIP_ONBOARDING=1
export HERMES_WEBUI_DEFAULT_WORKSPACE="${CONTAINER_WORKSPACE_FOLDER}"
EOF

source "${HERMES_HOME}/.env"
